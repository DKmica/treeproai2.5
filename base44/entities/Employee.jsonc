{
  "name": "Employee",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "enum": [
        "salesperson",
        "crew_leader",
        "groundman",
        "stump_grinder"
      ],
      "description": "Employee's position"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "pay_rate": {
      "type": "number",
      "description": "Hourly or daily pay rate"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "salary",
        "commission"
      ],
      "default": "hourly"
    },
    "territory": {
      "type": "string",
      "description": "Geographic area or specialty"
    },
    "max_leads": {
      "type": "number",
      "default": 10,
      "description": "Max concurrent leads (salesperson only)"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. emergency, residential, commercial"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "position"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}