{
  "name": "TreeRecord",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "species_confidence": {
      "type": "number"
    },
    "condition": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "dead",
        "hazardous"
      ],
      "default": "good"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "extreme"
      ],
      "default": "low"
    },
    "location_description": {
      "type": "string"
    },
    "height_estimate_ft": {
      "type": "number"
    },
    "dbh_inches": {
      "type": "number"
    },
    "canopy_spread_ft": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "recommended_next_service": {
      "type": "string"
    },
    "next_service_date": {
      "type": "string",
      "format": "date"
    },
    "ai_analysis_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "address": {
      "type": "string"
    }
  },
  "required": [
    "customer_id"
  ]
}