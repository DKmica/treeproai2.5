{
  "name": "Lead",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "Lead's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Lead's last name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "address": {
      "type": "string",
      "description": "Property address"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "referral",
        "google",
        "social_media",
        "door_to_door",
        "phone",
        "form",
        "other"
      ],
      "description": "How the lead found us"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "attempting_contact",
        "left_voicemail",
        "qualified",
        "quoted",
        "negotiating",
        "won",
        "lost",
        "disqualified"
      ],
      "default": "new",
      "description": "Current lead status"
    },
    "description": {
      "type": "string",
      "description": "Description of the service needed"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "emergency"
      ],
      "default": "normal"
    },
    "ai_score": {
      "type": "number",
      "description": "AI-generated lead score 0-100"
    },
    "ai_notes": {
      "type": "string",
      "description": "AI analysis notes"
    },
    "assigned_to": {
      "type": "string",
      "description": "Salesperson name assigned to this lead"
    },
    "assigned_to_id": {
      "type": "string",
      "description": "Salesperson ID assigned to this lead"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled follow-up date"
    },
    "follow_up_notes": {
      "type": "string",
      "description": "Notes for the follow-up call or visit"
    },
    "contact_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of contact attempts made"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last contact attempt"
    },
    "estimated_value": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "campaign": {
      "type": "string"
    },
    "converted_customer_id": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}