{
  "name": "Job",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "ai_analysis_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "unscheduled",
        "scheduled",
        "dispatched",
        "in_progress",
        "paused",
        "completed",
        "needs_follow_up",
        "invoiced",
        "paid",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "emergency"
      ],
      "default": "normal"
    },
    "description": {
      "type": "string"
    },
    "scope_of_work": {
      "type": "string"
    },
    "access_notes": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_start": {
      "type": "string"
    },
    "scheduled_end": {
      "type": "string"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "crew_id": {
      "type": "string"
    },
    "crew_name": {
      "type": "string"
    },
    "assigned_equipment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route_order": {
      "type": "number"
    },
    "dispatch_notes": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "extreme"
      ]
    },
    "hazards": {
      "type": "string"
    },
    "safety_notes": {
      "type": "string"
    },
    "required_crew_size": {
      "type": "number"
    },
    "estimated_duration_hours": {
      "type": "number"
    },
    "actual_duration_hours": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "satisfaction_rating": {
      "type": "number"
    },
    "completion_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "crane_required": {
      "type": "boolean",
      "default": false
    },
    "time_in": {
      "type": "string",
      "format": "date-time"
    },
    "time_out": {
      "type": "string",
      "format": "date-time"
    },
    "dump_logs": {
      "type": "array",
      "description": "Dump run records logged by crew \u2014 chips and wood loads, whether paid, and amount",
      "items": {
        "type": "object",
        "properties": {
          "material": {
            "type": "string",
            "description": "chips or wood"
          },
          "loads": {
            "type": "number"
          },
          "paid": {
            "type": "boolean"
          },
          "amount_paid": {
            "type": "number"
          },
          "site_name": {
            "type": "string"
          },
          "logged_at": {
            "type": "string"
          },
          "logged_by": {
            "type": "string"
          }
        }
      }
    },
    "dump_expense_total": {
      "type": "number",
      "default": 0,
      "description": "Total dump fees paid on this job (from crew dump logs)"
    },
    "dump_savings_total": {
      "type": "number",
      "default": 0,
      "description": "Total dump fees saved (free dumps \u00d7 minimum fee)"
    },
    "expenses_total": {
      "type": "number",
      "default": 0,
      "description": "Total of crew-logged expenses (fuel, supplies, equipment rental, etc.) excluding dump fees"
    },
    "dump_expense_chips": {
      "type": "number",
      "default": 0,
      "description": "Actual chips dump cost entered by staff"
    },
    "dump_expense_wood": {
      "type": "number",
      "default": 0,
      "description": "Actual wood/logs dump cost entered by staff"
    },
    "customer_signature_url": {
      "type": "string",
      "description": "URL of the customer's digital signature image captured on-site at quote approval"
    },
    "customer_signature_signed_by": {
      "type": "string",
      "description": "Full name of customer who signed"
    },
    "customer_signature_signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when customer signed on-site"
    },
    "customer_signature_salesperson": {
      "type": "string",
      "description": "Salesperson who collected the signature"
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}