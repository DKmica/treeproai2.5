{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "chainsaw",
        "chipper",
        "stump_grinder",
        "bucket_truck",
        "crane",
        "climbing_gear",
        "skid_steer",
        "trailer",
        "truck",
        "other"
      ]
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "serial_number": {
      "type": "string"
    },
    "license_plate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "in_use",
        "maintenance",
        "repair",
        "awaiting_parts",
        "retired"
      ],
      "default": "operational"
    },
    "condition": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "assigned_crew": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "current_value": {
      "type": "number"
    },
    "insurance_policy": {
      "type": "string"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date"
    },
    "registration_expiry": {
      "type": "string",
      "format": "date"
    },
    "last_maintenance": {
      "type": "string",
      "format": "date"
    },
    "next_maintenance": {
      "type": "string",
      "format": "date"
    },
    "maintenance_interval_days": {
      "type": "number"
    },
    "maintenance_interval_hours": {
      "type": "number",
      "description": "Hours of use between required maintenance (e.g. 50 for chainsaws, 250 for chippers)"
    },
    "hours_at_last_maintenance": {
      "type": "number",
      "default": 0,
      "description": "Hours reading when last maintenance was performed"
    },
    "hours_used": {
      "type": "number",
      "default": 0
    },
    "mileage": {
      "type": "number"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "gasoline",
        "diesel",
        "electric",
        "propane",
        "none"
      ]
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}