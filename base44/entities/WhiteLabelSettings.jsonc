{
  "name": "WhiteLabelSettings",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string"
    },
    "favicon_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#16a34a"
    },
    "secondary_color": {
      "type": "string",
      "default": "#f59e0b"
    },
    "custom_domain": {
      "type": "string"
    },
    "support_email": {
      "type": "string"
    },
    "footer_text": {
      "type": "string"
    },
    "show_powered_by": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}