{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#16a34a"
    },
    "secondary_color": {
      "type": "string",
      "default": "#f59e0b"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "service_area_description": {
      "type": "string"
    },
    "default_timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "default_currency": {
      "type": "string",
      "default": "USD"
    },
    "minimum_job_price": {
      "type": "number",
      "default": 150
    },
    "default_labor_rate_per_hour": {
      "type": "number",
      "default": 75
    },
    "crew_hourly_rate": {
      "type": "number",
      "default": 65
    },
    "estimator_hourly_rate": {
      "type": "number",
      "default": 85
    },
    "emergency_markup_percent": {
      "type": "number",
      "default": 40
    },
    "risk_markup_percent": {
      "type": "number",
      "default": 20
    },
    "profit_margin_percent": {
      "type": "number",
      "default": 35
    },
    "travel_fee_base": {
      "type": "number",
      "default": 0
    },
    "travel_fee_per_mile": {
      "type": "number",
      "default": 0
    },
    "stump_grinding_base_price": {
      "type": "number",
      "default": 100
    },
    "stump_grinding_per_inch": {
      "type": "number",
      "default": 4
    },
    "crane_day_rate": {
      "type": "number",
      "default": 1500
    },
    "dump_fee_base": {
      "type": "number",
      "default": 75
    },
    "disposal_fee_per_cubic_yard": {
      "type": "number",
      "default": 25
    },
    "dump_fee_chips_min": {
      "type": "number",
      "default": 50,
      "description": "Minimum dump fee per load of chips"
    },
    "dump_fee_wood_min": {
      "type": "number",
      "default": 100,
      "description": "Minimum dump fee per load of wood/logs"
    },
    "quote_expiration_days": {
      "type": "number",
      "default": 30
    },
    "public_estimate_disclaimer": {
      "type": "string"
    },
    "terms_and_conditions": {
      "type": "string"
    },
    "customer_portal_enabled": {
      "type": "boolean",
      "default": false
    },
    "public_widget_enabled": {
      "type": "boolean",
      "default": true
    },
    "max_upload_photos": {
      "type": "number",
      "default": 10
    },
    "max_photo_size_mb": {
      "type": "number",
      "default": 10
    },
    "minimum_large_removal_price": {
      "type": "number",
      "default": 4500,
      "description": "Minimum price for large tree removals (50-70 ft)"
    },
    "minimum_high_risk_removal_price": {
      "type": "number",
      "default": 6500,
      "description": "Minimum price for high-risk removals with structures nearby"
    },
    "minimum_extreme_removal_price": {
      "type": "number",
      "default": 8500,
      "description": "Minimum price for extreme complexity removals (70+ ft, near structures)"
    },
    "minimum_crane_removal_price": {
      "type": "number",
      "default": 10500,
      "description": "Minimum price when crane is likely or required"
    },
    "max_low_confidence_range_percent": {
      "type": "number",
      "default": 40,
      "description": "Max price range width (%) when confidence is low (<50%)"
    },
    "max_high_confidence_range_percent": {
      "type": "number",
      "default": 25,
      "description": "Max price range width (%) when confidence is high (>=70%)"
    },
    "oak_dense_wood_markup_percent": {
      "type": "number",
      "default": 15,
      "description": "Markup for oak/dense hardwoods due to weight and handling"
    },
    "structure_overhang_markup_percent": {
      "type": "number",
      "default": 20,
      "description": "Markup when canopy overhangs structures"
    },
    "limited_drop_zone_markup_percent": {
      "type": "number",
      "default": 15,
      "description": "Markup for limited drop zone / congested area"
    },
    "advanced_rigging_markup_percent": {
      "type": "number",
      "default": 20,
      "description": "Markup for advanced rigging requirements"
    },
    "crane_required_markup_percent": {
      "type": "number",
      "default": 30,
      "description": "Markup when crane is required"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}