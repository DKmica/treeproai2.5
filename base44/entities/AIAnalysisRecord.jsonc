{
  "name": "AIAnalysisRecord",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "original_customer_notes": {
      "type": "string"
    },
    "detected_species": {
      "type": "string"
    },
    "species_confidence": {
      "type": "number"
    },
    "estimated_height_ft_low": {
      "type": "number"
    },
    "estimated_height_ft_high": {
      "type": "number"
    },
    "estimated_dbh_inches_low": {
      "type": "number"
    },
    "estimated_dbh_inches_high": {
      "type": "number"
    },
    "canopy_spread_ft": {
      "type": "number"
    },
    "condition_summary": {
      "type": "string"
    },
    "hazards_detected": {
      "type": "string"
    },
    "access_difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "difficult",
        "very_difficult"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "extreme"
      ]
    },
    "urgency_level": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "emergency"
      ]
    },
    "crane_likely": {
      "type": "boolean",
      "default": false
    },
    "crane_required": {
      "type": "boolean",
      "default": false,
      "description": "Crane is required for safe removal"
    },
    "bucket_truck_likely": {
      "type": "boolean",
      "default": false
    },
    "climbing_required": {
      "type": "boolean",
      "default": false
    },
    "structures_nearby": {
      "type": "boolean",
      "default": false,
      "description": "Nearby structures (house, garage, fence, etc)"
    },
    "canopy_over_structure": {
      "type": "boolean",
      "default": false,
      "description": "Canopy overhangs a structure"
    },
    "limited_drop_zone": {
      "type": "boolean",
      "default": false,
      "description": "Limited space to drop wood/branches"
    },
    "stump_grinding_likely": {
      "type": "boolean",
      "default": false
    },
    "cleanup_volume_estimate": {
      "type": "string",
      "description": "Estimated cleanup volume in cubic yards or descriptive (e.g., 15-20 cubic yards)"
    },
    "recommended_service": {
      "type": "string"
    },
    "price_low": {
      "type": "number",
      "description": "Low estimate price"
    },
    "price_high": {
      "type": "number",
      "description": "High estimate price"
    },
    "confidence_score": {
      "type": "number",
      "description": "Confidence in estimate (0-100)"
    },
    "missing_info_questions": {
      "type": "string"
    },
    "ai_reasoning_summary": {
      "type": "string"
    },
    "complexity_score": {
      "type": "number",
      "description": "Calculated complexity score (0-100)"
    },
    "complexity_tier": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "extreme"
      ],
      "description": "Complexity tier based on score"
    },
    "pricing_floor": {
      "type": "number",
      "description": "Minimum price enforced for this job"
    },
    "range_width_percent": {
      "type": "number",
      "description": "Recommended price range width percentage"
    },
    "no_crane_price_low": {
      "type": "number",
      "description": "Price low for removal without crane"
    },
    "no_crane_price_high": {
      "type": "number",
      "description": "Price high for removal without crane"
    },
    "crane_required_price_low": {
      "type": "number",
      "description": "Price low if crane is required"
    },
    "crane_required_price_high": {
      "type": "number",
      "description": "Price high if crane is required"
    },
    "stump_price_low": {
      "type": "number",
      "description": "Optional stump grinding price low"
    },
    "stump_price_high": {
      "type": "number",
      "description": "Optional stump grinding price high"
    },
    "pricing_scenarios": {
      "type": "object",
      "additionalProperties": true,
      "description": "Detailed pricing scenarios (removal, with crane, with stump, etc)"
    },
    "human_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "corrected",
        "rejected"
      ],
      "default": "pending"
    },
    "human_final_price": {
      "type": "number"
    },
    "human_corrections": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}