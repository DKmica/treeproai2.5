      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "lead_id": {
      "type": "string",
      "description": "Original lead ID if converted"
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "jobs_count": {
      "type": "number",
