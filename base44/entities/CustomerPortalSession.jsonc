{
  "name": "CustomerPortalSession",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "used"
      ],
      "default": "active"
    },
    "viewed_at": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    }
  },
  "required": [
    "token"
  ]
}