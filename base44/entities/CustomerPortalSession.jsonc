{
  "name": "CustomerPortalSession",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "used"
      ],
      "default": "active"
    },
    "viewed_at": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    },
    "portal_email": {
      "type": "string",
      "description": "Customer email used for authenticated portal login"
    },
    "portal_pin": {
      "type": "string",
      "description": "6-digit PIN for customer portal login (plaintext for MVP, hash in production)"
    },
    "portal_pin_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the PIN login session expires"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    },
    "portal_type": {
      "type": "string",
      "enum": [
        "quote_approval",
        "customer_dashboard"
      ],
      "default": "quote_approval",
      "description": "Type of portal session"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}