{
  "name": "CustomerPortalSession",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "used"
      ],
      "default": "active"
    },
    "viewed_at": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}