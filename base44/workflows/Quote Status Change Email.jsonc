{
  "name": "Quote Status Change Email",
  "description": "Email the customer whenever a quote's status changes (sent, viewed, approved, invoiced, paid, etc.).",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Quote"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quote_status_change_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendCustomerNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendCustomerNotification"
  }
}