{
  "name": "Auto-Generate Invoice on Completion",
  "description": "Auto-generates a professional PDF invoice (pulling quote + labor details) when a job is marked complete.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_generate_invoice_on_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateJobInvoice",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateJobInvoice"
  }
}